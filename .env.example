# Copia este archivo como «.env» y rellena únicamente lo que necesites.
#
# El archivo .env está excluido del control de versiones y solo se emplea
# durante el desarrollo: en la aplicación distribuida, la clave se guarda
# cifrada en el Administrador de Credenciales de Windows.
#
# Las variables comentadas son opcionales: si las dejas así, se usan los
# valores por omisión.


# --- Proveedor de IA ------------------------------------------------------ #
#
# «openai» sirve para cualquier servicio que exponga ese formato de API:
# Groq, OpenRouter, Ollama, Cerebras, Mistral, Together o Gemini.
# «anthropic» usa la API nativa de Anthropic.

JARVIS_PROVIDER=openai

# Dirección del servicio. Admite un atajo conocido o una URL completa.
# Atajos: groq, openrouter, ollama, cerebras, mistral, together, gemini
JARVIS_BASE_URL=groq

# Clave de la API. Con Ollama en local puede dejarse vacía.
JARVIS_API_KEY=

# Identificador del modelo. Ejecuta «python scripts/diagnostico.py» para ver
# cuáles admite tu cuenta y copia uno de la lista.
JARVIS_MODEL=


# --- Ajustes opcionales --------------------------------------------------- #

# Límite de tokens por respuesta. Las respuestas son breves por diseño.
# JARVIS_MAX_TOKENS=1024

# Vueltas máximas del bucle de herramientas en un mismo turno.
# JARVIS_MAX_TOOL_ITERATIONS=8

# Nivel de detalle del registro: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# JARVIS_LOG_LEVEL=INFO

# Directorio alternativo para los datos de la aplicación.
# Por omisión: %APPDATA%\JARVIS
# JARVIS_DATA_DIR=


# --- Ejemplos de otras configuraciones ------------------------------------ #
#
# API nativa de Anthropic (de pago):
#   JARVIS_PROVIDER=anthropic
#   JARVIS_API_KEY=sk-ant-...
#   JARVIS_MODEL=claude-sonnet-5
#
# Ollama en local (gratis, sin internet, usa tu GPU):
#   JARVIS_PROVIDER=openai
#   JARVIS_BASE_URL=ollama
#   JARVIS_MODEL=el-modelo-que-hayas-descargado


# --- Voz (Fase 2) --------------------------------------------------------- #

# Motor de transcripción: «remote» (servicio, sin instalar nada) o «local»
# (faster-whisper en tu GPU; requiere «pip install -e ".[local-stt]"»).
# JARVIS_STT_BACKEND=remote

# Modelo de transcripción. Si se omite, el propio de cada motor.
# JARVIS_STT_MODEL=

# Idioma esperado. Fijarlo acelera la transcripción y evita saltos de lengua.
# JARVIS_STT_LANGUAGE=es

# Servicio y clave de transcripción. Si se omiten, se reutilizan los del
# modelo de lenguaje, que es lo habitual cuando ambos van por Groq.
# JARVIS_STT_BASE_URL=groq
# JARVIS_STT_API_KEY=

# Dispositivo del motor local: auto, cuda o cpu.
# JARVIS_STT_DEVICE=auto
